# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO

# Same values, read on the server (SSR)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=SEU-PROJETO

# Server only. Never expose to the browser. Used by account deletion (LGPD).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used only by drizzle-kit to run migrations
DATABASE_URL=
